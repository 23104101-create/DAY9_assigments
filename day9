-- TASK 3: STORED FUNCTION
-- fn_order_total_with_tax
-- =====================================================

DELIMITER //

CREATE FUNCTION fn_order_total_with_tax(
    p_order_id INT
)
RETURNS DECIMAL(12,2)
READS SQL DATA
BEGIN

    DECLARE v_total DECIMAL(12,2);

    SELECT COALESCE(SUM(line_total), 0)
    INTO v_total
    FROM order_items
    WHERE order_id = p_order_id;

    RETURN v_total + (v_total * 0.18);

END //

DELIMITER ;


-- USE FUNCTION INSIDE SELECT

SELECT
    order_id,
    fn_order_total_with_tax(order_id)
    AS Total_With_Tax
FROM orders;


