-- =====================================================
-- TASK 4: CURSOR WITH NOT FOUND HANDLER
-- =====================================================

DELIMITER //

CREATE PROCEDURE sp_pending_order_followups()
BEGIN

    DECLARE v_order_id INT;
    DECLARE v_done INT DEFAULT 0;


    -- DECLARE CURSOR

    DECLARE order_cursor CURSOR FOR
        SELECT order_id
        FROM orders
        WHERE status = 'PENDING'
        AND order_date < NOW() - INTERVAL 3 DAY;


    -- NOT FOUND HANDLER

    DECLARE CONTINUE HANDLER FOR NOT FOUND
        SET v_done = 1;


    -- OPEN CURSOR

    OPEN order_cursor;


    order_loop: LOOP

        -- FETCH RECORD

        FETCH order_cursor INTO v_order_id;


        -- STOP WHEN NO RECORDS

        IF v_done = 1 THEN
            LEAVE order_loop;
        END IF;


        -- INSERT FOLLOW-UP

        INSERT IGNORE INTO order_followups(
            order_id,
            remarks
        )
        VALUES(
            v_order_id,
            'Order pending for more than 3 days'
        );

    END LOOP;


    -- CLOSE CURSOR

    CLOSE order_cursor;

END //

DELIMITER ;


-- EXECUTE CURSOR PROCEDURE

CALL sp_pending_order_followups();


-- DISPLAY FOLLOW-UP RECORDS

SELECT * FROM order_followups;


