-- STEP 1: CREATE DATABASE

DROP DATABASE IF EXISTS retail_order_db;

CREATE DATABASE retail_order_db;

USE retail_order_db;


-- STEP 2: CREATE CUSTOMERS TABLE

CREATE TABLE customers (
    customer_id INT PRIMARY KEY AUTO_INCREMENT,
    customer_name VARCHAR(100) NOT NULL,
    email VARCHAR(100),
    phone VARCHAR(15)
);


-- STEP 3: CREATE PRODUCTS TABLE

CREATE TABLE products (
    product_id INT PRIMARY KEY AUTO_INCREMENT,
    product_name VARCHAR(100) NOT NULL,
    category VARCHAR(50),
    quantity INT NOT NULL,
    selling_price DECIMAL(10,2) NOT NULL,
    cost_price DECIMAL(10,2),
    supplier VARCHAR(100)
);


-- STEP 4: CREATE ORDERS TABLE

CREATE TABLE orders (
    order_id INT PRIMARY KEY AUTO_INCREMENT,
    customer_id INT NOT NULL,
    order_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    status VARCHAR(20) DEFAULT 'PENDING',

    FOREIGN KEY (customer_id)
    REFERENCES customers(customer_id)
);


-- STEP 5: CREATE ORDER_ITEMS TABLE

CREATE TABLE order_items (
    order_item_id INT PRIMARY KEY AUTO_INCREMENT,
    order_id INT NOT NULL,
    product_id INT NOT NULL,
    quantity INT NOT NULL,
    unit_price DECIMAL(10,2) NOT NULL,
    line_total DECIMAL(10,2) NOT NULL,

    FOREIGN KEY (order_id)
    REFERENCES orders(order_id),

    FOREIGN KEY (product_id)
    REFERENCES products(product_id)
);


-- STEP 6: CREATE ORDER_FOLLOWUPS TABLE

CREATE TABLE order_followups (
    followup_id INT PRIMARY KEY AUTO_INCREMENT,
    order_id INT NOT NULL,
    followup_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    remarks VARCHAR(255),

    UNIQUE (order_id),

    FOREIGN KEY (order_id)
    REFERENCES orders(order_id)
);


